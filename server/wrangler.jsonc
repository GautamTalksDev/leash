{
  // LEASH: control API (/v1/*), agent proxy (/p/*), and the site, one Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leash",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "leash.gautamkhosla.com", "custom_domain": true }],
  "assets": { "directory": "../site/public", "binding": "ASSETS", "run_worker_first": ["/v1/*", "/p/*"], "not_found_handling": "404-page" },
  "d1_databases": [{ "binding": "DB", "database_name": "leash", "database_id": "f275b6ea-aa0a-477a-a843-6caf89c74ca9", "migrations_dir": "migrations" }],
  "vars": { "RP_ID": "leash.gautamkhosla.com", "ORIGIN": "https://leash.gautamkhosla.com" },
  // Secrets (wrangler secret put): LEASH_KEK (32 random bytes, base64url), IP_SALT, VAPID_PRIVATE_JWK (phone alerts: node dev/vapid-keygen.mjs | npx wrangler secret put VAPID_PRIVATE_JWK)
  // Cleanup also runs inline on ~2% of requests (src/index.js sweep). Add a cron here on a paid plan if you like.
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
